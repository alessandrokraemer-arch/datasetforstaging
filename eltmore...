USE [DATABASE_THE_FOR_STAGING];

--- HERE IS FOR SHOWING STATISTICS BY MS SQL SERVER´S SCHEDULING
SET STATISTICS TIME ON;

--- HERE IS FOR REDUCING THE LATENCY DURING THE LOAD THE ELT BY INSERTING. 
ALTER INDEX ALL ON "TABLE_NAME" DISABLE;

--- A BULK IS THE BEST WAY ...
BULK INSERT "TEMPORARY_TABLE_THE_SAME_TABLE_NAME" 
FROM 'FULL_FILE_PATH'
WITH (
  --- USUALY NUMBER 2
  FIRSTROW = 2,
  FIELDTERMINATOR = ';',
  ROWTERMINATOR = '\n',
  KILOBYTES_PER_BATCH = 1024,
  --- FOR EXAMPLING THERE BELLOW THE NUMBER 1 THOUSAND ROWS PER EACH PROCESSING
  --- BATCHSIZE = 1000    
)

--- HERE AGAIN THE BACK TO NORMAL
ALTER INDEX ALL ON "TABLE_NAME_THE_SAME_THERE" REBUILD;
SET STATISTICS TIME OFF;
